# Build output
/bin/
/dist/
/patchcord
/patchcord.exe

# Go
*.test
*.out
vendor/

# Local runtime data
*.db
*.db-journal
*.sqlite
*.sqlite3
/data/

# Reference plugin executables embedded into the patchcord binary
# (ADR-0059) — built by `make build-embedded-plugins` / the release
# pipeline's per-target pre-hook, never committed. .gitkeep keeps each
# platform directory (and its go:embed directive) present on a fresh
# checkout — see internal/plugins/embedded.
/internal/plugins/embedded/bin/*/*
!/internal/plugins/embedded/bin/*/.gitkeep

# Secrets and local config overrides
.env
.env.*
*.local.yaml
*.local.yml

# Package signing private keys (never commit — ADR-0043). The public key
# (*.pub) is meant to be shared and is intentionally not ignored here.
patchcord-signing-key
*-signing-key

# Node (sdk/typescript, apps/examples)
node_modules/
dist/

# mdBook build output
/docs/book/book/

# Editors and OS
.vscode/
.idea/
.DS_Store

# OMX
.omx/