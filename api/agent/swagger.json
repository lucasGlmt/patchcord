{
    "swagger": "2.0",
    "info": {
        "description": "Public HTTP API for the Patchcord agent (vision document, section 10.1). Covers workflow triggering and run observability, connector CRUD and testing, application hosting, and a read-only plugin catalog listing; the rest of the vision document's API surface (actions, full plugin management) is not implemented yet.\nEvery route marked with a lock icon below requires \"Authorization: Bearer \u003cadmin token\u003e\" — but only once at least one admin token has been created (`patchcord auth token create`); a fresh agent answers every request unauthenticated, exactly as before this existed (ADR-0036).",
        "title": "Patchcord Agent API",
        "contact": {},
        "version": "1"
    },
    "basePath": "/v1",
    "paths": {
        "/apps": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns every installed application and the permissions its sessions are limited to.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "apps"
                ],
                "summary": "List installed applications",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/api.appSummary"
                            }
                        }
                    }
                }
            }
        },
        "/apps/{id}/sessions": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Issues a new session for the named application, limited to its manifest's declared permissions. The token is a bearer credential: pass it as \"Authorization: Bearer \u003ctoken\u003e\" to POST /workflows/{id}/run.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "apps"
                ],
                "summary": "Issue an application session",
                "parameters": [
                    {
                        "type": "string",
                        "description": "App id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/api.appSessionResponse"
                        }
                    },
                    "404": {
                        "description": "app not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/connectors": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns every recorded connector, ordered by id. Never includes a resolved secret value — only each secret reference's logical type/key.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "connectors"
                ],
                "summary": "List connectors",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/api.connectorSummary"
                            }
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Creates a new connector: a persistent, named configuration for accessing an external system. type must match a connector type declared by an installed plugin's manifest.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "connectors"
                ],
                "summary": "Create a connector",
                "parameters": [
                    {
                        "description": "Connector to create",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/api.createConnectorRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/api.connectorSummary"
                        }
                    },
                    "400": {
                        "description": "malformed request body, or the connector is invalid (empty id/type, unknown type, unsupported secret reference type)",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "409": {
                        "description": "a connector with this id already exists",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/connectors/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns one connector's configuration and secret references (never a resolved secret value).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "connectors"
                ],
                "summary": "Get a connector",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Connector id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.connectorSummary"
                        }
                    },
                    "404": {
                        "description": "connector not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Removes a connector. There is no update endpoint (ADR-0020) — a caller that wants to change one recreates it, which is exactly what the dashboard's \"Modifier\" does under the hood.",
                "tags": [
                    "connectors"
                ],
                "summary": "Delete a connector",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Connector id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "deleted"
                    },
                    "404": {
                        "description": "connector not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/connectors/{id}/test": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Resolves the connector's configuration and secrets, then asks the installed plugin that declares its type to actually attempt a connection. Unlike GET /connectors/{id}, this calls into a live plugin process. A connection attempt that runs but fails (e.g. wrong password) is reported as ok=false, not an HTTP error.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "connectors"
                ],
                "summary": "Test a connector",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Connector id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.connectorTestResponse"
                        }
                    },
                    "404": {
                        "description": "connector not found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "no connector tester configured, a secret failed to resolve, or the plugin call itself failed",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/plugins": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns every installed plugin and the connector types/action ids/permissions its manifest declares — enough for a client to build a connector-type picker without a copy of the CLI's own catalog logic.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "plugins"
                ],
                "summary": "List installed plugins",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/api.pluginSummary"
                            }
                        }
                    }
                }
            }
        },
        "/runs": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns every recorded run, most recently created first.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "runs"
                ],
                "summary": "List runs",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Restrict to runs of this workflow id",
                        "name": "workflow_id",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/api.runSummary"
                            }
                        }
                    }
                }
            }
        },
        "/runs/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns one run's current status, outputs and steps — the counterpart to POST /workflows/{id}/run's immediate response, letting a client poll a run or fetch its final result once GET /runs/{id}/events has closed.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "runs"
                ],
                "summary": "Get a run",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Run id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.runSummary"
                        }
                    },
                    "404": {
                        "description": "run not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/runs/{id}/cancel": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Marks a run still queued or running as cancelled. Does not interrupt a run actively executing within this same process — it only flips its recorded status; an in-flight step keeps running until its next persistence checkpoint, where it then stops cleanly.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "runs"
                ],
                "summary": "Cancel a run",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Run id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.runSummary"
                        }
                    },
                    "404": {
                        "description": "run not found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "409": {
                        "description": "run has already finished",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/runs/{id}/events": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Streams a run's status changes, and its steps', as Server-Sent Events until the run reaches a terminal status or the client disconnects. The \"event:\" field is \"run.\u003cstatus\u003e\" or \"step.\u003cstatus\u003e\"; \"data:\" is a JSON-encoded event payload.",
                "produces": [
                    "text/event-stream"
                ],
                "tags": [
                    "runs"
                ],
                "summary": "Stream a run's events",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Run id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "text/event-stream",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "run not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/system/health": {
            "get": {
                "description": "Reports whether the agent's database is reachable, and the\nagent's own release version (see `patchcord version`).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Check agent health",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.healthResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/api.healthResponse"
                        }
                    }
                }
            }
        },
        "/system/metrics": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns a JSON snapshot of the agent's in-process metrics registry (run/step transitions and durations, plugin supervision, scheduler activity, connector tests) — the same data GET /metrics exposes in Prometheus text format, reshaped for a dashboard or application. See ADR-0070.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Get a metrics snapshot",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.systemMetricsResponse"
                        }
                    }
                }
            }
        },
        "/webhooks/{id}": {
            "post": {
                "description": "Starts a new run of the latest installed version of the named workflow, if it declares a \"webhook\" trigger — the request body's top-level JSON object becomes the run's inputs directly, not wrapped in {\"inputs\": ...}. Requires \"X-Patchcord-Webhook-Token: \u003cthe trigger's resolved secret_ref\u003e\" — never an admin token.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "webhooks"
                ],
                "summary": "Trigger a workflow via its webhook",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Workflow id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "$ref": "#/definitions/api.runSummary"
                        }
                    },
                    "400": {
                        "description": "the body isn't a JSON object, or its fields don't satisfy the workflow's declared input schema",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "missing or incorrect X-Patchcord-Webhook-Token",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "workflow not found, or its trigger isn't \\\"webhook\\",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "no action executor configured, the secret_ref doesn't resolve, or a persistence failure",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/workflows": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns every installed workflow version, most recently installed first. The same workflow id can appear more than once if multiple versions are installed (workflows are immutable once published — installing a new version never replaces an old one).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "workflows"
                ],
                "summary": "List installed workflows",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/api.workflowSummary"
                            }
                        }
                    }
                }
            }
        },
        "/workflows/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns one workflow version's full definition: its steps and raw YAML source. Defaults to the latest installed version.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "workflows"
                ],
                "summary": "Get a workflow version's definition",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Workflow id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Workflow version (defaults to the latest installed one)",
                        "name": "version",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.workflowDetail"
                        }
                    },
                    "400": {
                        "description": "version is not a valid integer",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "workflow not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/workflows/{id}/run": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Starts a new run of the latest installed version of the named workflow and returns immediately with its id and initial status — it does not wait for any step to execute. Watch GET /runs/{id}/events or poll GET /runs/{id} for progress and the final result.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "workflows"
                ],
                "summary": "Trigger a workflow run",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Workflow id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Inputs and connector bindings (both optional, default to none)",
                        "name": "body",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/api.runWorkflowRequest"
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "$ref": "#/definitions/api.runSummary"
                        }
                    },
                    "400": {
                        "description": "malformed request body, or inputs don't satisfy the workflow's declared schema",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "workflow not found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "no action executor configured, or a persistence failure",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "api.appSessionResponse": {
            "type": "object",
            "properties": {
                "app_id": {
                    "type": "string"
                },
                "connectors_use": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "issued_at": {
                    "type": "string"
                },
                "token": {
                    "type": "string"
                },
                "workflows_run": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "api.appSummary": {
            "type": "object",
            "properties": {
                "connectors_use": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "id": {
                    "type": "string"
                },
                "version": {
                    "type": "string"
                },
                "workflows_run": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "api.connectorMetricsResponse": {
