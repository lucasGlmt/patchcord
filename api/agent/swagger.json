                    }
                },
                "workflow_id": {
                    "type": "string"
                },
                "workflow_version": {
                    "type": "integer"
                }
            }
        },
        "api.runWorkflowRequest": {
            "type": "object",
            "properties": {
                "bindings": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "inputs": {
                    "type": "object",
