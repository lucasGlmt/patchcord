                "key": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                }
            }
        },
        "api.connectorSummary": {
            "type": "object",
            "properties": {
                "config": {
                    "type": "object",
                    "additionalProperties": {}
                },
                "created_at": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "secret_refs": {
                    "type": "object",
